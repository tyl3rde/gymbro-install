# Release-Caddyfile: TLS automatisch per HTTP-01 (Let's Encrypt).
# Voraussetzungen: A-/AAAA-Record der Domain zeigt auf diesen Server,
# Ports 80 und 443 sind offen. Kein DNS-Plugin, kein API-Token nötig.
{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  header {
    X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # CSP: alles same-origin. unsafe-inline für Theme-Boot-Script + Inline-
    # Styles (Next.js-Hydration / style={{}}), blob:/data: für Foto-Preview.
    # frame-ancestors 'none' = moderne Clickjacking-Sperre (wie X-Frame DENY).
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    -Server
  }

  # ‼️ Kein trusted_proxies, mit Absicht: Caddy hängt hier direkt am Netz
  # und ist der EINZIGE Hop vor der App. Mitgeschickte X-Forwarded-* verwirft
  # es und setzt die echte Gegenstelle — darauf baut der Login-Schutz
  # (lib/client-ip.js). Kommt ein CDN davor (Cloudflare-Proxy, orange Wolke),
  # sieht die App nur noch dessen Edge-Adressen, und der IP-Bann sperrt die
  # ganze Crew auf einmal (Issue #10). Dann gehören die IP-Bereiche des CDN
  # als trusted_proxies samt trusted_proxies_strict in den globalen Block.
  reverse_proxy wheres-gymbro:3000
}
